# Default safety mode (A): no real order by default
EXECUTION_MODE=paper

# Binance Spot Testnet REST base (use only /api/*)
BINANCE_TESTNET_BASE_URL=https://testnet.binance.vision/api

# Create key on Spot Test Network (GitHub login required)
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=

# Safety mode (C): must be YES for live testnet order
BINANCE_TESTNET_TRADING_ENABLED=NO

# Signed-request controls
BINANCE_TESTNET_RECV_WINDOW=5000

# Risk hard limits
BINANCE_TESTNET_MAX_NOTIONAL=20
BINANCE_TESTNET_MAX_ORDERS_PER_MIN=5
